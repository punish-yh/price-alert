# ===== 账号（必填其一）=====
ADMIN_USERNAME=admin
# 方式一：明文密码（仅首次启动用，启动后建议删除此行改用哈希）
ADMIN_PASSWORD=change-me-to-a-strong-password
# 方式二（推荐）：bcrypt 哈希，用 backend/make_hash.py 生成
# ADMIN_PASSWORD_HASH=

# ===== 安全 =====
# 随机长字符串；不设置会自动生成并保存到 backend/data/secret.key
# SECRET_KEY=
# 会话有效期（小时）
TOKEN_TTL_HOURS=12
# 通过 HTTPS 对外暴露时必须设为 true
COOKIE_SECURE=false
# 登录连续失败次数 / 锁定分钟数
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# ===== Binance =====
# K线轮询间隔（秒）：每 5 分钟检查一次 5m K 线的 开/收/高/低 价
POLL_INTERVAL=300
# K 线周期
KLINE_INTERVAL=5m
# USDT 永续合约节点（用于与现货加权合成标准价）
FUTURES_BASE_URLS=https://fapi.binance.com

# ===== TradingView 转发 =====
# TV webhook 鉴权令牌；不设置会自动生成并保存到 backend/data/tv_token.key
# TV_WEBHOOK_TOKEN=
# 单 IP 转发限流：次数 / 窗口秒数
TV_RATE_LIMIT=60
TV_RATE_WINDOW=3600
# 行情节点（逗号分隔，自动回退）
# BINANCE_BASE_URLS=https://api.binance.com,https://api1.binance.com,https://data-api.binance.vision

# ===== 饭碗告警（必填，否则告警发送失败）=====
# 在 fwalert.com 创建规则后得到的 webhook 地址
FWALERT_WEBHOOK=https://fwalert.com/你的-webhook-id

# ===== SEC 财报监听 =====
# 监听窗口内的轮询间隔（秒）。走全市场 feed，每轮固定 2 个请求，与标的数量无关
SEC_POLL_INTERVAL=15
# 所有任务都在窗口外时的休眠间隔（秒）
SEC_IDLE_INTERVAL=120
# SEC 公平使用政策上限 10 req/s，所有请求共享该限额
SEC_MAX_RPS=10
# SEC 要求请求携带可联系到的 User-Agent，建议改成自己的邮箱
SEC_USER_AGENT=price-alert admin@example.com
